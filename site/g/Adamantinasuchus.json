{"name": "Adamantinasuchus", "clade": "sphagesauridae", "isd": false, "isnote": "", "sum": "Adamantinasuchus is a small notosuchian crocodylomorph known from one fossil from the Late Cretaceous Adamantina Formation of Brazil.", "wsnote": "The skull is only 60 mm long and about 30 mm high; no body length is given.", "holotype": "UFRJ-DG 107-R, a partial skull, fragmentary limb bones and a few broken vertebrae, found 25 km south-west of Marília and collected by William Nava.", "material": "The holotype only.", "completeness": "fragmentary", "exceptional": "", "biology": "Very large elliptical orbits, nearly as long as the rostrum, might indicate nocturnal habits; its premaxilla bore two incisiform teeth and one caniniform tooth.", "author": "Nobre and Carvalho 2006", "fad": 83.6, "lad": 66, "early": "Campanian", "late": "Maastrichtian", "type_species": "Adamantinasuchus navae", "pbdb_occ": 1, "species": [{"name": "Adamantinasuchus navae", "author": "Nobre and Carvalho 2006", "fad": 83.6, "lad": 66, "interval": "Campanian–Maastrichtian", "ref": "original description"}], "formations": [{"ids": ["adamantina-brazil"], "formation": "Adamantina", "group": "Bauru", "members": [], "country": "Brazil", "regions": ["São Paulo"], "interval": "Late Campanian–Early Maastrichtian", "n": 1, "ma": [66.0, 83.6]}], "images": [{"kind": "life", "file": "Adamantinasuchus BW.jpg", "src": "https://upload.wikimedia.org/wikipedia/commons/7/73/Adamantinasuchus_BW.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "page": "https://commons.wikimedia.org/wiki/File:Adamantinasuchus_BW.jpg", "artist": "Nobu Tamura ( http://spinops.blogspot.com )", "license": "CC BY 3.0", "licurl": "https://creativecommons.org/licenses/by/3.0", "date": "2007-10-31", "caption": "Adamantinasuchus restoration (Bogdanov).", "w": 800, "h": 369, "local": "img/gallery/Adamantinasuchus_001.webp", "review": "unreviewed"}], "sources": [{"kind": "original", "text": "P. H. Nobre and I. d. S. Carv