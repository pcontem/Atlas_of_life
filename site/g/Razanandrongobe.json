{"name": "Razanandrongobe", "clade": "notosuchia", "isd": true, "isnote": "PBDB places it in Baurusuchia; English Wikipedia calls it a ziphosuchian; left in Notosuchia.", "sum": "Razanandrongobe is a large predatory ziphosuchian crocodyliform from the Middle Jurassic of Madagascar, about 7 m long.", "wsnote": "About 7 m long, the largest known notosuchian (English Wikipedia); an estimate.", "holotype": "Isolated bones including a maxilla fragment and teeth, found in 2003 in the Sakaraha Formation, Bathonian, Madagascar; Catalogue number not given in the sources consulted.", "material": "Isolated bones and teeth; further material described by Dal Sasso et al. 2017.", "completeness": "fragmentary", "exceptional": "", "biology": "Teeth with large serrations and palate reinforcement suggest a diet that included bones and tendons (English Wikipedia).", "author": "Maganuco et al. 2006", "fad": 168.2, "lad": 165.3, "early": "Bathonian", "late": "", "type_species": "Razanandrongobe sakalavae", "pbdb_occ": 2, "species": [{"name": "Razanandrongobe sakalavae", "author": "Maganuco et al. 2006", "fad": 168.2, "lad": 165.3, "interval": "Bathonian", "ref": "original description"}], "formations": [{"ids": ["isalo-iiib-madagascar"], "formation": "Isalo IIIb", "group": "", "members": [], "country": "Madagascar", "regions": ["Mahajanga"], "interval": "Bathonian", "n": 2, "ma": [165.3, 168.2]}], "images": [{"kind": "fossil", "file": "Razanandrongobe sakalavae 7.JPG", "src": "https://upload.wikimedia.org/wikipedia/commons/0/05/Razanandrongobe_sakalavae_7.JPG?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "page": "https://commons.wikimedia.org/wiki/File:Razanandrongobe_sakalavae_7.JPG", "artist": "Ghedoghedo", "license": "CC BY-SA 3.0", "licurl": "https://creativecommons.org/licenses/by-sa/3.0", "date": "2011-10-02", "caption": "Razanandrongobe sakalavae fossil.", "w": 529, "h": 432, "local": null, "review": "unreviewed"}, {"kind": "fossil", "file": "Razanandrongobe-fig2-MNHTspecimens.jpg", "src": "https://upload.wikimedia.org/wikipedia/commons/5/56/Razanandrongobe-fig2-MNHTspecimens.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "page": "https://commons.wikimedia.org/wiki/File:Razanandrongobe-fig2-MNHTspecimens.jpg", "artist": "Cristiano Dal Sasso​​, Giovanni Pasini, Guillaume Fleury, Simone Maganuco", "license": "CC BY 4.0", "licurl": "https://creativecommons.org/licenses/by/4.0", "date": "2017-07-04", "caption": "Razanandrongobe specimens (Maganuco et al.).", "w": 914, "h": 1200, "local": null, "review": "unreviewed"}, {"kind": "fossil", "file": "Razanandrongobe-fig4-dentary.jpg", "src": "https://upload.wikimedia.org/wikipedia/commons/3/3c/Razanandrongobe-fig4-dentary.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "page": "https://commons.wikimedia.org/wiki/File:Razanandrongobe-fig4-dentary.jpg", "artist": "Cristiano Dal Sasso​​, Giovanni Pasini, Guillaume Fleury, Simone Maganuco", "license": "CC BY 4.0", "licurl": "https://creativecommons.org/licenses/by/4.0", "date": "2017-07-04", "caption": "Razanandrongobe dentary.", "w": 1200, "h": 735, "local": null, "review": "unreviewed"}, {"kind": "fossil", "file": "Razanandrongobe-fig6-teeth.jpg", "src": "https://upload.wikimedia.org/wikipedia/commons/d/d2/Razanandrongobe-fig6-teeth.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "page": "https://commons.wikimedia.org/wiki/File:Razanandrongobe-fig6-teeth.jpg", "artist": "Cristiano Dal Sasso​​, Giovanni Pasini, Guillaume Fleury, Simone Maganuco", "license": "CC BY 4.0", "licurl": "https://creativecommons.org/licenses/by/4.0", "date": "2017-07-04", "caption": "Razanandrongobe teeth.", "w": 898, "h": 1200, "local": null, "review": "unreviewed"}, {"kind": "life", "file": "Razanandrongobe life reconstruction.png", "src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Razanandrongobe_life_reconstruction.png/960