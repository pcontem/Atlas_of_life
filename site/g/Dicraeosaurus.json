", "license": "CC BY-SA 3.0", "licurl": "https://creativecommons.org/licenses/by-sa/3.0", "date": "2009", "caption": "Mounted skeleton of Dicraeosaurus in Berlin.", "w": 2552, "h": 1525, "local": "img/gallery/Dicraeosaurus_001.webp", "review": "unreviewed"}, {"kind": "fossil", "file": "Dicraeosaurus hansemanni Eleventh Cervical Vertebra.jpg", "src": "https://upload.wikimedia.org/wikipedia/commons/6/62/Dicraeosaurus_hansemanni_Eleventh_Cervical_Vertebra.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "page": "https://commons.wikimedia.org/wiki/File:Dicraeosaurus_hansemanni_Eleventh_Cervical_Vertebra.jpg", "artist": "Amy Campbell", "license": "CC BY-SA 3.0", "licurl": "https://creativecommons.org/licenses/by-sa/3.0", "date": "2020-03-11", "caption": "Eleventh cervical vertebra of Dicraeosaurus hansemanni.", "w": 1548, "h": 2502, "local": "img/gallery/Dicraeosaurus_002.webp", "review": "unreviewed"}, {"kind": "fossil", "file": "Dicraeosaurus hansemanni Sixth Cervical Vertebra.jpg", "src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/a/ac/Dicraeosaurus_hansemanni_Sixth_Cervical_Vertebra.jpg/960px-Dicraeosaurus_hansemanni_Sixth_Cervical_Vertebra.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "page": "https://commons.wikimedia.org/wiki/File:Dicraeosaurus_hansemanni_Sixth_Cervical_Vertebra.jpg", "artist": "Amy Campbell", "license": "CC BY-SA 3.0", "licurl": "https://creativecommons.org/licenses/by-sa/3.0", "date": "2020-01-28", "caption": "Sixth cervical vertebra of Dicraeosaurus hansemanni.", "w": 1824, "h": 1902, "local": "img/gallery/Dicraeosaurus_003.webp", "review": "unreviewed"}, {"kind": "life", "file": "Dicraeosaurus BW.jpg", "src": "https://upload.wikimedia.org/wikipedia/commons/1/1b/Dicraeosaurus_BW.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "page": "https://commons.wikimedia.org/wiki/File:Dicraeosaurus_BW.jpg", "artist": "Nobu Tamura ( http://s