{"name": "Eoraptor", "clade": "sauropodomorpha", "isd": false, "isnote": "", "sum": "Eoraptor is a small, lightly built basal sauropodomorph, one of the oldest known dinosaurs, from the Late Triassic Ischigualasto Formation of Argentina.", "wsnote": "Known specimens measure 1.2-1.3 m and weighed about 10 kg or less (Wikipedia revision).", "holotype": "PVSJ 512, an almost complete skeleton from the Cancha de Bochas Member of the Ischigualasto Formation; it took almost twelve months to collect.", "material": "The holotype and several fragmentary skeletons.", "completeness": "near-complete", "exceptional": "", "biology": "The holotype femur is 152 mm and the tibia 157 mm, which suggests a fast runner.", "author": "Sereno et al. 1993", "fad": 233.6, "lad": 227.3, "early": "Carnian", "late": "", "type_species": "Eoraptor lunensis", "pbdb_occ": 1, "species": [{"name": "Eoraptor lunensis", "author": "Sereno et al. 1993", "fad": 233.6, "lad": 227.3, "interval": "Carnian", "ref": "original description"}], "formations": [{"ids": ["ischigualasto-argentina"], "formation": "Ischigualasto", "group": "", "members": ["Cancha de Bochas"], "country": "Argentina", "regions": ["San Juan"], "interval": "Tuvalian", "n": 1, "ma": [227.3, 233.6]}], "images": [{"kind": "life", "file": "Eoraptor NT small.jpg", "src": "https://upload.wikimedia.org/wikipedia/commons/4/49/Eoraptor_NT_small.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "page": "https://commons.wikimedia.org/wiki/File:Eoraptor_NT_small.jpg", "artist": "Nobu Tamura email:nobu.tamura@yahoo.com http://spinops.blogspot.com/ http://paleoexhibit.blogspot.com/", "license": "CC BY-SA 4.0", "licurl": "https://creativecommons.org/licenses/by-sa/4.0", "date": "2016-07-19", "caption": "Life restoration of Eoraptor with a human silhouette for scale.", "w": 773, "h": 532, "local": "img/gallery/Eoraptor_001.webp", "review": "unreviewed"}, {"kind": "fossil", "file": "Eoraptor Lunensis 20250105.jpg", "src": "h