02"}, {"kind": "literature", "text": "Choiniere, Jonah N.; Clark, James M.; Norell, Mark A.; Xu, Xing 2014. Cranial Osteology of ''Haplocheirus sollers'' Choiniere et al., 2010 (Theropoda: Alvarezsauroidea). American Museum Novitates(3816): 1–44. doi:10.1206/3816.1"}, {"kind": "database", "text": "Paleobiology Database — taxon and occurrence records for Junggarsuchus (downloaded 2026-11-17).", "url": "https://paleobiodb.org/classic/basicTaxonInfo?taxon_name=Junggarsuchus"}, {"kind": "encyclopedia", "text": "Wikipedia contributors. “Junggarsuchus”. English Wikipedia, revision 1344478799.", "url": "https://en.wikipedia.org/w/index.php?title=Junggarsuchus&oldid=1344478799"}], "len": null, "silhouette": {"src": "https://images.phylopic.org/images/2f9a790f-996f-482e-8f9c-a4bfbdde18ea/vector.svg", "png": "https://images.phylopic.org/images/2f9a790f-996f-482e-8f9c-a4bfbdde18ea/raster/512x156.png", "page": "https://www.phylopic.org/images/2f9a790f-996f-482e-8f9c-a4bfbdde18ea", "attribution": "Miguel Hernández", "license": "https://creativecommons.org/publicdomain/zero/1.0/", "depicts": "Almadasuchus figarii", "matched": "Solidocrania", "genus_level": false, "w": 512, "h": 156}, "cur": {"status": "draft", "origin": "ai-draft", "by": "", "on": "", "reviews": [], "src": "entries/pseudosuchia/genera/Junggarsuchus.yaml"}, "vol": "pseudosuchia"}